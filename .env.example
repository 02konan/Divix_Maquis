# Copier ce fichier en .env et adapter les valeurs.

# Clé de signature des sessions Flask (à changer en production).
SECRET_KEY=divix-maquis-dev

# Connexion MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
DATABASE=divix_maquis

# Optionnel : se connecter par socket Unix plutôt que par TCP.
# MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
